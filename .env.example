# ============================================================
# Mie Elon Musk - Environment Configuration
# ============================================================
# Salin file ini menjadi .env.local lalu isi nilai yang sesuai.
# Jangan pernah commit file .env.local ke repository.
# ============================================================

# Backend Laravel API (server-side only, tidak dikirim ke browser)
LARAVEL_API_URL=http://127.0.0.1:8000/api

# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=   # Generate dengan: openssl rand -hex 32

# Google OAuth Provider
GOOGLE_CLIENT_ID=       # Dari Google Cloud Console > Credentials
GOOGLE_CLIENT_SECRET=   # Dari Google Cloud Console > Credentials

# Public App Config (dikirim ke browser)
NEXT_PUBLIC_APP_NAME="Mie Elon Musk Cikarang"
NEXT_PUBLIC_STORE_LOCATION="Cikarang, Jawa Barat"
